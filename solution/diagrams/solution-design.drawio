          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="new evidence;&lt;br&gt;reason stays visible" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="rejected" target="evaluating">
