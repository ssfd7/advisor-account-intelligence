        <mxCell id="a9" value="operational record" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="using" target="discontinued">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Testimony-driven changes are proposed until a reviewer confirms them. If the CRM disagrees with a confirmed QBR statement, both are shown and a Discrepancy is raised. Each change is dated, cites its source and affects only this product relationship: never the platform relationship or other products. Intent or clickstream alone never moves a relationship to using.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="60" y="580" width="1270" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="qbr-continuity-workflow" name="QBR continuity workflow">
