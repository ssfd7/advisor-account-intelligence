          <mxGeometry relative="1" x="0.3" as="geometry" />
        </mxCell>
        <mxCell id="w-rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Notification alone never completes a handoff. A QBR whose extraction fails or yields nothing stays pending until a reviewer resolves it. Assignment records keep created_by separate from assigned_to, so revoking Jordan&amp;#x27;s access removes retrieval rights, not records.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="90" y="790" width="2120" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>