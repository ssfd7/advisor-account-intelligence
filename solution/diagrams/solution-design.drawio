        <mxCell id="expanding" value="&lt;b&gt;expanding&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E4F1E3;strokeColor=#666666;strokeWidth=1;fontSize=15;fontColor=#222222;" parent="1" vertex="1">
