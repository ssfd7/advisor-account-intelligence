        <mxCell id="a5" value="same contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="h-orch" target="h-rep">
          <mxGeometry relative="1" x="0.4" as="geometry">
