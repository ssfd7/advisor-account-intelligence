          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-scopes" value="&lt;b&gt;Memory scopes (federated)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#FAFAFA;strokeColor=#888888;strokeWidth=1;fontSize=14;fontColor=#222222;" parent="1" vertex="1">
