          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="h-contract" value="&lt;b&gt;Evidence contract&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;carried by every handoff, agent or human&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;task_id · procedure_version · taxonomy_version&lt;br&gt;subject · product_targets&lt;br&gt;evidence_refs (node IDs and spans, not copied text)&lt;br&gt;claims with verification_state&lt;br&gt;access_scope (most restrictive of inputs)&lt;br&gt;owner · acknowledged_at · deadline&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="520" y="500" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="h-rep" value="&lt;b&gt;Covering rep&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Receives the same contract; acknowledges before owning the work&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1160" y="520" width="360" height="110" as="geometry" />
