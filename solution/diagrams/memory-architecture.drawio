        <mxCell id="h-mem" value="&lt;b&gt;Shared memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;graph and source store&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Specialists read within their scopes; writes go through validation&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E4F1E3;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
