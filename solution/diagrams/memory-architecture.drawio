        </mxCell>
        <mxCell id="s-session" value="&lt;b&gt;Session&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;working memory for one brief&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1060" y="335" width="405" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-role" value="&lt;b&gt;Role-restricted&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;asset definitions, compliance review notes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FBE5EC;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1000" y="550" width="525" height="90" as="geometry" />
        </mxCell>
        <mxCell id="scope-note" value="Derived summaries, caches, embeddings and handoff payloads inherit the most restrictive scope of their inputs. Access is enforced at retrieval and traversal, before anything reaches model context." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="25" y="740" width="1550" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
