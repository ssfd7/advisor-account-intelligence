  <diagram id="context-assembly" name="Context assembly">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="660" background="#FFFFFF" math="0" shadow="0" lineJumpsEnabled="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Context assembly for one brief" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#222222;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="25" y="14" width="1570" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Bounded, cited, access-scoped. Details: memory-architecture.md §8." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="25" y="50" width="1570" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c-req" value="&lt;b&gt;Request&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Subject, review date, requesting user&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF2CC;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="30" y="270" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-acc" value="&lt;b&gt;Access filter&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Restrict to the user&amp;#x27;s scopes before retrieval&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
