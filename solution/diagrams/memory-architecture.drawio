        </mxCell>
        <mxCell id="h-note" value="A handoff is incomplete until the receiver acknowledges it. Claims cite evidence references rather than restating facts, so the receiver can verify them against shared memory." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="80" y="740" width="1440" height="44" as="geometry" />
