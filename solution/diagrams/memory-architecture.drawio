  <diagram id="memory-types-and-scopes" name="Memory types and scopes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" background="#FFFFFF" math="0" shadow="0" lineJumpsEnabled="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Memory types and federated scopes" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#222222;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="25" y="14" width="1550" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Left: what is remembered and how it moves between types. Right: who can retrieve it. Details: memory-architecture.md §2–3." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="25" y="50" width="1550" height="26" as="geometry" />
        </mxCell>
        <mxCell id="g-types" value="&lt;b&gt;Memory types&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F4FAF0;strokeColor=#888888;strokeWidth=1;fontSize=14;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="25" y="90" width="900" height="640" as="geometry" />
        </mxCell>
        <mxCell id="working" value="&lt;b&gt;Working memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;session and task store&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Draft brief, unresolved candidates, context bundle. Expires on approval, disposition or timeout.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="50" y="140" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="episodic" value="&lt;b&gt;Episodic memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;graph and source spans&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;QBRs, experience observations, intents, product decisions, action outcomes. Durable.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E5EFFA;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="50" y="340" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="semantic" value="&lt;b&gt;Semantic memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;graph&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Confirmed identities, affiliations, product relationships and states, capabilities, current intent. Versioned; superseded, never overwritten.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E4F1E3;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="50" y="540" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="procedural" value="&lt;b&gt;Procedural memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;versioned Markdown&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Approved QBR-preparation and follow-up procedure; intent taxonomy version.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FBE5EC;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="500" y="140" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="assoc" value="&lt;b&gt;Associative recall&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;typed graph traversal&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;From the subject, follow addresses, targets, considersAlternative and supersedes links. Embedding search proposes candidate spans; graph links confirm them.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="500" y="400" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="extraction and reviewer validation" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="working" target="episodic">
