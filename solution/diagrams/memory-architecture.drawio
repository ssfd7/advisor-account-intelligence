        </mxCell>
        <mxCell id="s-team" value="&lt;b&gt;Team&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;QBRs, takeaways, actions, coverage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="1000" y="200" width="525" height="330" as="geometry" />
        </mxCell>
        <mxCell id="s-rel" value="&lt;b&gt;Relationship (firm or advisor)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;profile, product relationships, experience, intent, assets&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF2CC;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
