        <mxCell id="subtitle" value="Specialists are kept only if measured quality or operational benefit justifies their cost. Details: memory-architecture.md §7." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1">
