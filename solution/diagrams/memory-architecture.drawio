        <mxCell id="h-prof" value="&lt;b&gt;Profile and metric checker&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Identity, qualifications versus registration, AUM/AUA scope&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="80" y="320" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="h-prod" value="&lt;b&gt;Product comparison&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Catalog-grounded comparison; unknown stays unknown&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1">
          <mxGeometry x="620" y="320" width="360" height="100" as="geometry" />
