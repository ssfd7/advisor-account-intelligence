<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="640" background="#FFFFFF" math="0" shadow="0" lineJumpsEnabled="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="From QBR note to owned follow-up" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#222222;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="25" y="14" width="1670" height="34" as="geometry" /></mxCell><mxCell id="subtitle" value="Read each arrow as source, label, target. Dashed: procedural memory used by a step." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="25" y="50" width="1670" height="26" as="geometry" /></mxCell><mxCell id="note" value="&lt;b&gt;QBR note&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;Salesforce export&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Stored when it arrives; queued for SME review with a deadline&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF2CC;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="30" y="120" width="170" height="130" as="geometry" /></mxCell><mxCell id="detect" value="&lt;b&gt;1 · Concept detection&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;agent&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Links product mentions to the catalog by name or alias; reads asset figures&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="225" y="120" width="170" height="130" as="geometry" /></mxCell><mxCell id="extract" value="&lt;b&gt;2 · Candidate findings&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;agent: Claude or fixtures&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Experience, intent, commitments, each with its exact sentence&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="420" y="120" width="170" height="130" as="geometry" /></mxCell><mxCell id="sqbr" value="&lt;b&gt;3 · Semantic QBR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;OKF concept, status: draft&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Mentions, asset figures and findings in one reviewable file&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E5EFFA;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="615" y="120" width="170" height="130" as="geometry" /></mxCell><mxCell id="sme" value="&lt;b&gt;4 · SME approval&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;human: the one gate&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Confirm or reject each finding; overdue reviews escalate to the lead&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="810" y="120" width="170" height="130" as="geometry" /></mxCell><mxCell id="hydrate" value="&lt;b&gt;5 · Hydration&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;agent&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Writes approved knowledge and starts the follow-up run&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1005" y="120" width="170" height="130" as="geometry" /></mxCell><mxCell id="a1" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="note" target="detect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="detect" target="extract"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a3" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="extract" target="sqbr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a4" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="sqbr" target="sme"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a5" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="sme" target="hydrate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="graph" value="&lt;b&gt;Knowledge graph&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;LadybugDB&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Semantic and episodic memory, bitemporal&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E4F1E3;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1290" y="90" width="180" height="95" as="geometry" /></mxCell><mxCell id="run" value="&lt;b&gt;Procedure run&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;task store&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Steps bound to findings, owners and due dates&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1290" y="215" width="180" height="95" as="geometry" /></mxCell><mxCell id="brief" value="&lt;b&gt;Brief and owned follow-up&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;for the rep&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;One cited page; every promise has an owner&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E5EFFA;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1530" y="120" width="170" height="130" as="geometry" /></mxCell><mxCell id="a6" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="hydrate" target="graph"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a7" value="starts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="hydrate" target="run"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a8" value="queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="graph" target="brief"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a9" value="open steps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" edge="1" source="run" target="brief"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ref" value="&lt;b&gt;Catalog, taxonomy, asset definitions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;semantic memory&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Names, aliases, intents, allowed computations&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E4F1E3;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="225" y="330" width="170" height="105" as="geometry" /></mxCell><mxCell id="a10" value="links against" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="ref" target="detect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="rejected" value="&lt;b&gt;Rejected findings&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;episodic memory&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Kept with the reviewer&amp;#x27;s reason&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="810" y="330" width="170" height="105" as="geometry" /></mxCell><mxCell id="a11" value="rejected" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="sme" target="rejected"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="coverage" value="&lt;b&gt;Coverage and escalation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;team lead&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;An absent owner&amp;#x27;s steps go to a colleague who acknowledges&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1290" y="340" width="180" height="105" as="geometry" /></mxCell><mxCell id="a12" value="owner unavailable" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="run" target="coverage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="bundle" value="&lt;b&gt;OKF bundle: procedural memory (bundle/)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fillColor=#F8F4FB;strokeColor=#888888;strokeWidth=1;fontSize=14;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="420" y="480" width="780" height="140" as="geometry" /></mxCell><mxCell id="b-proc" value="&lt;b&gt;Procedure&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Steps 1–8, performed by agent or human, with uses&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="435" y="515" width="175" height="90" as="geometry" /></mxCell><mxCell id="b-comp" value="&lt;b&gt;Computations&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Read ontology terms; implemented in aai/queries.py&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="625" y="515" width="175" height="90" as="geometry" /></mxCell><mxCell id="b-tool" value="&lt;b&gt;Tools&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Write ontology terms; the only way to change memory&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="815" y="515" width="175" height="90" as="geometry" /></mxCell><mxCell id="b-gloss" value="&lt;b&gt;Glossary and mapping&lt;/b&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Generated from the Turtle and graph schema; checked&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1005" y="515" width="175" height="90" as="geometry" /></mxCell><mxCell id="a13" value="steps and tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="bundle" target="hydrate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a14" value="format" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;dashed=1;dashPattern=6 4;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="bundle" target="sqbr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cap" value="Nothing derived from a note enters semantic, episodic or procedural memory without SME approval." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="25" y="560" width="380" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="memory-types" name="Memory types"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="760" background="#FFFFFF" math="0" shadow="0" lineJumpsEnabled="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Five memory types, one gate" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#222222;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="25" y="14" width="1570" height="34" as="geometry" /></mxCell><mxCell id="subtitle" value="What each memory holds in this product. Read each arrow as source, label, target." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#444444;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="25" y="50" width="1570" height="26" as="geometry" /></mxCell><mxCell id="note2" value="&lt;b&gt;QBR note&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;Salesforce export&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;The advisor&amp;#x27;s words, as recorded&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF2CC;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="30" y="470" width="270" height="90" as="geometry" /></mxCell><mxCell id="working" value="&lt;b&gt;Working memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;in flight, short-lived&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Concept detection output&lt;br&gt;Candidate findings&lt;br&gt;Draft semantic QBR&lt;br&gt;Brief evidence bundle and draft&lt;br&gt;&lt;br&gt;Cleared once the decision is recorded or the draft expires&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="30" y="110" width="270" height="300" as="geometry" /></mxCell><mxCell id="a1" value="detection and extraction" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="note2" target="working"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gate" value="&lt;b&gt;SME approval&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;the one gate&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Confirm or reject each finding, with reasons&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FCE4D6;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="345" y="200" width="150" height="120" as="geometry" /></mxCell><mxCell id="a2" value="draft" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;" parent="1" edge="1" source="working" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="semantic" value="&lt;b&gt;Semantic memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;what the firm knows&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Catalog with names, aliases, capabilities, prerequisites · intent taxonomy · AUM/AUA definitions · identities kept apart by registry id · exams and registrations, separately · current product states and intents&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E4F1E3;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="600" y="100" width="470" height="150" as="geometry" /></mxCell><mxCell id="episodic" value="&lt;b&gt;Episodic memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;what happened, was said, and when&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;QBRs and emails as they arrived · approved semantic QBRs, each finding tied to its sentence · rejected findings with reasons · repetitions linked, not counted twice · narrow supersession · as-of answers · outcomes with evidence&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E4F1E3;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="600" y="270" width="470" height="150" as="geometry" /></mxCell><mxCell id="procedural" value="&lt;b&gt;Procedural memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;how the firm acts&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;OKF bundle: the QBR procedure, computations and tools with generated glossaries · procedure runs binding steps to findings, owners and due dates&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#EEE5F4;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="600" y="440" width="470" height="150" as="geometry" /></mxCell><mxCell id="a3" value="promotes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="gate" target="semantic"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a4" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" parent="1" edge="1" source="gate" target="episodic"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a5" value="starts a run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" parent="1" edge="1" source="gate" target="procedural"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="567" /></Array></mxGeometry></mxCell><mxCell id="a6" value="stored on arrival" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" parent="1" edge="1" source="note2" target="episodic"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="497" /><mxPoint x="560" y="390" /></Array></mxGeometry></mxCell><mxCell id="assoc" value="&lt;b&gt;Associative memory&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;connecting the note to the firm&amp;#x27;s knowledge&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Entity linking: &amp;quot;their UMA&amp;quot; and &amp;quot;CPX UMA&amp;quot; resolve to CPX Unified Managed Account by name or alias; anything else is left unresolved for the SME.&lt;br&gt;&lt;br&gt;Typed traversal: finding → product → capability → prerequisite → commitment → action.&lt;br&gt;&lt;br&gt;Vector similarity may locate a sentence; it is never treated as truth.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#E5EFFA;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1160" y="100" width="430" height="490" as="geometry" /></mxCell><mxCell id="a7" value="traverses" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="assoc" target="semantic"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a8" value="traverses" style="edgeStyle=none;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="assoc" target="episodic"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a9" value="links mentions for" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;strokeWidth=1.2;fontSize=12;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=classic;endSize=7;jumpStyle=arc;jumpSize=8;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="assoc" target="working"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1375" y="85" /><mxPoint x="165" y="85" /></Array></mxGeometry></mxCell><mxCell id="scopes" value="&lt;b&gt;Access scopes on all five&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;enforced at retrieval&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Organization · team · relationship · role · session. Summaries, caches and handoffs inherit the most restrictive scope of their inputs.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="30" y="620" width="1040" height="110" as="geometry" /></mxCell><mxCell id="retention" value="&lt;b&gt;Retention&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;decay without amnesia&lt;/font&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Duplicates and expired drafts are pruned; rare high-value events and rejection reasons are kept.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F2F2F2;strokeColor=#666666;strokeWidth=1;fontSize=13;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="1160" y="620" width="430" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>